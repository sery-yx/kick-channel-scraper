# docker compose reads these from a file called .env: cp .env.example .env
# A value that contains a $ has to be wrapped in single quotes ('...'), otherwise compose expands it.

# credentials of a Kick app (kick.com/settings/developer), for example the one rustlog-kick uses
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# adminAPIKey of the rustlog-kick instance
RUSTLOG_API_KEY=

# address of the rustlog-kick instance as the container sees it, where 127.0.0.1 is the container itself.
# Use the one that fits:
#   http://host.docker.internal:8025   rustlog-kick runs on this server, on port 8025 and listening on
#                                      all addresses (0.0.0.0), not only on 127.0.0.1
#   http://rustlog-kick:8025           rustlog-kick is a container on the same Docker network,
#                                      use the name of its service
#   https://logs.example.com           rustlog-kick runs somewhere else
RUSTLOG_URL=http://host.docker.internal:8025
